{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "failing_test", "evidence", "confidence", "rerun"],
  "properties": {
    "verdict": { "enum": ["flaky", "real", "infra"] },
    "failing_test": { "type": "string" },
    "evidence": { "type": "string" },
    "location": { "type": "string", "description": "file:line of the likely cause, when known" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "rerun": { "type": "boolean", "description": "true only for a flaky failure" }
  }
}
